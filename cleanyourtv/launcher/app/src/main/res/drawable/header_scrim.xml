<?xml version="1.0" encoding="utf-8"?>
<!-- header_scrim: a soft shade behind the clock, darkest at the top edge and gone well above the dock, so the
     header reads over any wallpaper and rows scrolling up meet a darker band instead of a bare cut. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#B3060406"
        android:centerColor="#59060406"
        android:centerY="0.45"
        android:endColor="#00060406" />
</shape>
