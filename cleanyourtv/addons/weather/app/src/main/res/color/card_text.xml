<?xml version="1.0" encoding="utf-8"?>
<!-- Text and icons on a day card: white, dark once the card is focused and turns white. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF111111" />
    <item android:color="#FFFFFFFF" />
</selector>
