<?xml version="1.0" encoding="utf-8"?>
<!-- Leaving: the whole window fades, one layer the GPU composites. Fading the page's own views instead made a
     layer of the column every frame: on the Mi Box it never showed, and cut the days' row on its way out. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="180"
    android:fromAlpha="1"
    android:interpolator="@android:interpolator/accelerate_quad"
    android:toAlpha="0" />
