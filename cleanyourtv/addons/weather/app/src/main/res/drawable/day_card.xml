<?xml version="1.0" encoding="utf-8"?>
<!-- A forecast day: the launcher's glass panel (glass_panel), a little see-through so the glow shows; white while
     focused, like a tile. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D92A2A2E" android:endColor="#D9161618" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
