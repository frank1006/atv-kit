<?xml version="1.0" encoding="utf-8"?>
<!-- Options, set before building. With the defaults the page is as the README describes it. -->
<resources>
    <!-- Days in the row after today, 3 to 7. The cards keep their size; when they do not fit, the row scrolls. -->
    <integer name="forecast_days">3</integer>
    <!-- The relative humidity now, as a pill after "Feels like". -->
    <bool name="show_humidity">false</bool>
    <!-- The wind speed now, as a pill after "Feels like": km/h, or mph with temperature_unit f. -->
    <bool name="show_wind">false</bool>
    <!-- c: degrees Celsius. f: degrees Fahrenheit, for the temperature now, feels-like, the days' highs and lows
         and the wind (mph). -->
    <string name="temperature_unit" translatable="false">c</string>
    <!-- The temperature now in the other unit too, at the start of the "Feels like" pill ("22°C · Feels like 70°"). -->
    <bool name="show_both_units">false</bool>
    <!-- auto: the national weather service's model for the chosen city's country where Open-Meteo has one (Canada,
         the US, France, the UK and Ireland, the Nordics, Denmark, the Benelux, Switzerland, Japan, China), DWD's
         ICON elsewhere and for any day the national model does not reach. Or one Open-Meteo model for every
         place, such as icon_seamless (the add-on's only model before auto) or gem_seamless. -->
    <string name="weather_model" translatable="false">auto</string>
</resources>
